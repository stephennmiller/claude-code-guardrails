{
  "$comment": "Merge these hooks into your repo's .claude/settings.json. Order within a matcher is the order they run; the first non-zero exit wins.",
  "permissions": {
    "$comment": "A hook is a speed bump: it can be overridden, and it only sees the tool calls its matcher catches. permissions.deny is a wall. Put things here that are never right from an agent, and leave the judgement calls to the guards. Keep this list short -- a long deny list gets loosened.",
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks-scripts/secret-scan-guard.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks-scripts/config-sync-guard.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks-scripts/blast-radius-guard.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "$comment": "blast-radius-guard is listed under BOTH matchers on purpose. A guard registered only for Write|Edit leaks through Bash -- `sed -i` and `bash -c` are edits too. This is the single most common way a hook set is quietly useless.",
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks-scripts/git-safety.py\"",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks-scripts/watch-mode-guard.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks-scripts/blast-radius-guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks-scripts/auto-format-code.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
